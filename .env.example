# REQUIRED: Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# REQUIRED: Get from https://aistudio.google.com/app/apikey
# Primary model for AI tasks (chat, NLP, SQL generation, OCR, embeddings)
GOOGLE_API_KEY=

# REQUIRED: Get from https://console.anthropic.com/settings/keys
# Fallback model for AI tasks (chat, NLP, SQL generation, OCR) - Claude Opus 4.5
ANTHROPIC_API_KEY=

# Security: Comma-separated Telegram user IDs (get from @userinfobot)
# Leave empty to allow all (development only)
ALLOWED_TELEGRAM_USER_IDS=

# WhatsApp bot (Twilio)
# Never hardcode these in code. Copy values from the Twilio Console into .env.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_DEFAULT_CONTENT_SID=

# Security: comma-separated WhatsApp numbers, with or without + / whatsapp:
# Example: +918114437166,whatsapp:+911234567890
# Leave empty to allow all (development only)
ALLOWED_WHATSAPP_NUMBERS=

# Optional: map WhatsApp phone numbers to existing Telegram user IDs so both bots share the same data.
# Format: phone:telegram_id,phone2:telegram_id2
# Example: WHATSAPP_USER_LINKS=+918114437166:1189734335
WHATSAPP_USER_LINKS=
WHATSAPP_BOT_HOST=0.0.0.0
WHATSAPP_BOT_PORT=8001

# Dashboard REST API (run_api.py)
API_HOST=0.0.0.0
API_PORT=8002

WHATSAPP_MEDIA_TIMEOUT_SECONDS=30
WHATSAPP_MAX_BODY_LENGTH=4000
WHATSAPP_MAX_MEDIA_COUNT=1
WHATSAPP_MESSAGE_CACHE_SECONDS=900

# Optional production guardrail. Keep false for quick ngrok testing.
# If true, also set WHATSAPP_PUBLIC_BASE_URL to your public ngrok/domain without trailing slash.
WHATSAPP_VERIFY_TWILIO_SIGNATURE=false
WHATSAPP_PUBLIC_BASE_URL=

# Database (PostgreSQL required)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/expence

# Optional settings (defaults shown):
# OPENAI_TIMEOUT=45 (legacy, can be removed)
# OPENAI_MAX_RETRIES=2 (legacy, can be removed)
# MAX_MESSAGE_LENGTH=3500
# MAX_CONVERSATION_HISTORY=10
# LOG_LEVEL=INFO

# Async OCR queue (Redis + Celery)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# CELERY_WORKER_CONCURRENCY=4
# CELERY_TASK_MAX_RETRIES=3
# CELERY_TASK_RETRY_BACKOFF_SECONDS=10
# OCR_TASK_SOFT_TIME_LIMIT=120
# OCR_TASK_TIME_LIMIT=180
# OCR_MAX_INFLIGHT_PER_USER=3

# Automated WhatsApp Reports (Celery Beat)
# Times are in UTC. Default 16:30 UTC = 22:00 IST.
# DAILY_REPORT_HOUR_UTC=16
# DAILY_REPORT_MINUTE_UTC=30
# Weekly report fires every Monday by default (0=Monday … 6=Sunday)
# WEEKLY_REPORT_DAY_OF_WEEK=0
# WEEKLY_REPORT_HOUR_UTC=16
# WEEKLY_REPORT_MINUTE_UTC=30
