# REQUIRED: Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# REQUIRED: Get from https://aistudio.google.com/app/apikey
# Primary model for AI tasks (chat, NLP, SQL generation, OCR, embeddings)
GOOGLE_API_KEY=

# REQUIRED: Get from https://console.anthropic.com/settings/keys
# Fallback model for AI tasks (chat, NLP, SQL generation, OCR) - Claude Opus 4.5
ANTHROPIC_API_KEY=

# Security: Comma-separated Telegram user IDs (get from @userinfobot)
# Leave empty to allow all (development only)
ALLOWED_TELEGRAM_USER_IDS=

# Database (SQLite by default, or use PostgreSQL)
# DATABASE_URL=sqlite:///bot_data.db

# Optional settings (defaults shown):
# OPENAI_TIMEOUT=45 (legacy, can be removed)
# OPENAI_MAX_RETRIES=2 (legacy, can be removed)
# MAX_MESSAGE_LENGTH=3500
# MAX_CONVERSATION_HISTORY=10
# LOG_LEVEL=INFO
